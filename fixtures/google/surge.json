iv>\r\n\r\n                <content class=\"quantumTabContent\">\r\n                  Card\r\n                </content>\r\n\r\n                <div class=\"quantumTabListIndicator\"></div>\r\n              </div>\r\n\r\n              <div class=\"quantumTab\">\r\n                <div class=\"quantumTabRipple\"></div>\r\n\r\n                <content class=\"quantumTabContent\">\r\n                  Toolbar\r\n                </content>\r\n\r\n                <div class=\"quantumTabListIndicator\"></div>\r\n              </div>\r\n\r\n              <div class=\"quantumTab\">\r\n                <div class=\"quantumTabRipple\"></div>\r\n\r\n                <content class=\"quantumTabContent\">\r\n                  Tooltip\r\n                </content>\r\n\r\n                <div class=\"quantumTabListIndicator\"></div>\r\n              </div>\r\n\r\n              <div class=\"quantumTab\">\r\n                <div class=\"quantumTabRipple\"></div>\r\n\r\n                <content class=\"quantumTabContent\">\r\n                  Progress\r\n                </content>\r\n\r\n                <div class=\"quantumTabListIndicator\"></div>\r\n              </div>\r\n\r\n              <div class=\"quantumTab\">\r\n                <div class=\"quantumTabRipple\"></div>\r\n\r\n                <content class=\"quantumTabContent\">\r\n                  Dialog\r\n                </content>\r\n\r\n                <div class=\"quantumTabListIndicator\"></div>\r\n              </div>\r\n            </div>\r\n          </content>\r\n        </nav>\r\n      </div>\r\n    </div>\r\n  </header>\r\n\r\n  <div class=\"quantumCenteredContent\">\r\n    <content class=\"components shadowElevation-3dp\">\r\n      <h3 style=\"margin-top: 0\">Button component</h3>\r\n      <div role=\"button\" class=\"quantumButton quantumButtonDark quantumButtonRaised animated\">\r\n        <div class=\"quantumButtonOverlay\"></div>\r\n\r\n        <content class=\"quantumButtonContent\">\r\n          <span>Button</span>\r\n        </content>\r\n      </div>\r\n\r\n      <div role=\"button\" class=\"quantumButton quantumButtonFlat\">\r\n        <div class=\"quantumButtonOverlay\"></div>\r\n\r\n        <content class=\"quantumButtonContent\">\r\n          <span>Button</span>\r\n        </content>\r\n      </div>\r\n\r\n      <h3>Checkbox component</h3>\r\n      <div role=\"checkbox\" class=\"quantumCheckbox\">\r\n        <div class=\"quantumCheckboxInnerBox\"></div>\r\n        <div class=\"quantumCheckboxCheckMarkContainer\">\r\n          <div class=\"quantumCheckboxCheckMark\">\r\n            <div class=\"quantumCheckboxShort\"></div>\r\n            <div class=\"quantumCheckboxLong\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Using polymer ripple:\r\n      <div role=\"button\" class=\"quantumButton quantumButtonDark quantumButtonRaised\">\r\n        <link rel=\"import\" href=\"//www.polymer-project.org/0.5/components/paper-ripple/paper-ripple.html\">\r\n        <div class=\"quantumButtonOverlay\"></div>\r\n\r\n        <content class=\"quantumButtonContent\">\r\n          <span>Button</span>\r\n        </content>\r\n\r\n        <paper-ripple fit></paper-ripple>\r\n      </div>-->\r\n\r\n      <h3>Fab component</h3>\r\n      <div class=\"quantumFab\">\r\n        <img class=\"quantumFabIcon\" src=\"//ssl.gstatic.com/bt/C3341AA7A1A076756462EE2E5CD71C11/1x/bt_speed_dial_1x.png\" alt=\"\">\r\n      </div>\r\n\r\n      <h3>Input component</h3>\r\n      <div class=\"quantumCard\">\r\n        <div class=\"quantumCardContent\" style=\"padding: 10px 15px;\">\r\n          <input role=\"combobox\" type=\"text\" placeholder=\"Type here your name\" class=\"quantumInput\">\r\n        </div>\r\n      </div>\r\n\r\n      <h3>Card component</h3>\r\n      <div class=\"quantumCard\">\r\n        <div class=\"quantumCardAccent\"></div>\r\n\r\n        <div class=\"quantumCardContent\">\r\n          Hello world!\r\n        </div>\r\n      </div>\r\n\r\n      <h3>Tooltip component</h3>\r\n      <span class=\"quantumTooltip isActive\" style=\"visibility: visible; position: relative; display: inline-block\">\r\n        <span class=\"quantumTooltipBackground\"></span>\r\n        <span class=\"quantumTooltipText\">This is my tooltip</span>\r\n      </span>\r\n\r\n      <h3>Toolbar component</h3>\r\n      <div class=\"quantumToolbar\">\r\n        <div class=\"quantumToolbarLeft\">\r\n          <content>Left</content>\r\n        </div>\r\n\r\n        <h1 class=\"quantumToolbarTitle\">My title</h1>\r\n\r\n        <div class=\"quantumToolbarRight\">\r\n          <content>Right</content>\r\n        </div>\r\n      </div>\r\n\r\n      <h3>Navbar component</h3>\r\n      <div class=\"quantumNavbar\">\r\n        <div class=\"quantumNavbarItemFlat\">\r\n          Example\r\n        </div>\r\n      </div>\r\n\r\n      <h3>Tab component</h3>\r\n      <div class=\"quantumTabList\">\r\n        <div class=\"quantumTab isSelected\">\r\n          <div class=\"quantumTabRipple\"></div>\r\n\r\n          <content class=\"quantumTabContent\">\r\n            Questions\r\n          </content>\r\n\r\n          <div class=\"quantumTabListIndicator\"></div>\r\n        </div>\r\n        \r\n        <div class=\"quantumTab\">\r\n          <div class=\"quantumTabRipple\"></div>\r\n\r\n          <content class=\"quantumTabContent\">\r\n            Answers\r\n          </content>\r\n        </div>\r\n      </div>\r\n\r\n      <h3>Progress buffer component</h3>\r\n      <div class=\"quantumProgressBuffer\">\r\n        <div class=\"quantumProgressBufferBar\">\r\n          <div class=\"quantumProgressBufferBarExtra\"></div>\r\n        </div>\r\n      </div>\r\n\r\n      <h3>Toast component</h3>\r\n      <div class=\"quantumToast\" style=\"position: relative; left: 0;\">\r\n        <content class=\"quantumToastContent\">\r\n          <span class=\"quantumProgressSpinner\"></span>\r\n\r\n          <span>Loading...</span>\r\n        </content>\r\n      </div>\r\n\r\n      <h3>Dialog component</h3>\r\n      <div role=\"button\" class=\"quantumButton quantumButtonFlat quantumButtonDialogTrigger\" data-modal=\"myDialog\">\r\n        <div class=\"quantumButtonOverlay\"></div>\r\n\r\n        <content class=\"quantumButtonContent\">\r\n          <span>Confirm</span>\r\n        </content>\r\n      </div>\r\n\r\n      <div id=\"myDialog\" class=\"quantumDialogBackground\">\r\n        <div class=\"quantumDialogLayout\">\r\n          <div class=\"quantumDialog\">\r\n            <div class=\"quantumDialogTitlebar\">My dialog</div>\r\n\r\n            <content class=\"quantumDialogContent\">\r\n              <div>\r\n                <div class=\"\">item</div>\r\n              </div>\r\n            </content>\r\n\r\n            <div class=\"quantumDialogActions\">\r\n\r\n              <div role=\"button\" class=\"quantumButton quantumButtonFlat\">\r\n                <div class=\"quantumButtonOverlay\"></div>\r\n\r\n                <content class=\"quantumButtonContent\">\r\n                  <span>Close</span>\r\n                </content>\r\n              </div>\r\n              \r\n              <div role=\"button\" class=\"quantumButton quantumButtonFlat\" data-confirm>\r\n                <div class=\"quantumButtonOverlay\"></div>\r\n\r\n                <content class=\"quantumButtonContent\">\r\n                  <span>Confirm</span>\r\n                </content>\r\n              </div>\r\n\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </content>\r\n  </div>\r\n\r\n  <script>\r\n  var button = require('quantum/button');\r\n  var checkbox = require('quantum/checkbox');\r\n  var dialog = require('quantum/dialog');\r\n\r\n  button.bind(document.querySelector('div[role=\"button\"].quantumButtonRaised.animated'));\r\n  checkbox.bind(document.querySelector('.quantumCheckbox'));\r\n  dialog.bind(document.querySelector('.quantumButtonDialogTrigger'));\r\n  </script>\r\n</body>\r\n</html>",
