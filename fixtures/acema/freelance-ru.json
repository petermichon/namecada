) => {\n                const confirmedAt = CookieUtils.get(storageKey) || localStorage.getItem(storageKey);\n                if (!confirmedAt) return false;\n\n                const confirmedTime = parseInt(confirmedAt, 10);\n                return Date.now() - confirmedTime < confirmInterval;\n            };\n\n            // Установка подтверждения\n            // withMetrika=true  → пользователь разрешил метрику\n            // withMetrika=false → пользователь выбрал «Без метрики»\n            const setConfirmed = (withMetrika = true) => {\n                const now = Date.now().toString();\n                if (isLocalStorageSupported) {\n                    localStorage.setItem(storageKey, now);\n                    if (withMetrika) localStorage.setItem(metrikaKey, now);\n                    else localStorage.removeItem(metrikaKey);\n                } else {\n                    CookieUtils.set(storageKey, now, 180);\n                    if (withMetrika) CookieUtils.set(metrikaKey, now, 180);\n                    else CookieUtils.delete(metrikaKey);\n                }\n            };\n\n            const loadMetrika = () => {\n                if (typeof window.initYaMetrika === 'function') window.initYaMetrika();\n            };\n\n            // Показ баннера\n            const showBanner = () => {\n                const privacyUrl = '/privacy.html#cookies';\n                const leaveUrl = 'https://ya.ru/';\n                const banner = document.createElement('div');\n                banner.innerHTML = `\n<div id=\"cookie-banner\" class=\"user-cookie-confirm\" style=\"display:none; z-index: 100; position: fixed; bottom:0; background: white; width: 100%; padding: 20px 15px; box-shadow: 0 -3px 3px 0 rgba(5,49,89,0.2);\">\n    <div style=\"display: flex; align-items: center; gap: 15px; flex-wrap: wrap; justify-content: space-evenly;\">\n        <div class=\"text-center\">\n            На сайте используются файлы cookie и сервис Яндекс.Метрика для улучшения работы платформы,\n            обеспечения безопасности и аналитики.\n            <a class=\"text-link\" id=\"user-cookie-link-href\" href=\"${privacyUrl}\" target=\"_blank\">Подробнее о Политике конфиденциальности</a>\n        </div>\n        <div id=\"cookie-actions\" style=\"display:flex; gap:8px; flex-wrap:wrap; justify-content:center; align-items:center;\">\n                        <a href=\"${leaveUrl}\" class=\"btn btn-link\" id=\"cookie-leave\" style=\"margin: 5px\">отказаться и покинуть сайт</a>\n            <button class=\"btn btn-success\" id=\"cookie-accept\" style=\"border-radius: 50px; margin: 5px\">Согласен</button>\n        </div>\n        <div id=\"cookie-settings-panel\" style=\"display:none; width:100%; text-align:center; padding-top:10px; border-top:1px solid #eee; margin-top:5px;\">\n            <button class=\"btn btn-success\" id=\"cookie-allow-all\" style=\"border-radius: 50px; margin: 5px\">Разрешить все</button>\n            <button class=\"btn btn-default\" id=\"cookie-no-metrika\" style=\"border-radius: 50px; margin: 5px\">Без метрики</button>\n        </div>\n    </div>\n</div>\n`;\n                document.body.appendChild(banner);\n                const bannerElement = document.getElementById('cookie-banner');\n                bannerElement.style.display = 'block';\n\n                // Согласен — разрешить всё включая метрику\n                document.getElementById('cookie-accept').addEventListener('click', () => {\n                    setConfirmed(true);\n                    loadMetrika();\n                    bannerElement.remove();\n                });\n\n                // // Настроить — раскрыть расширенные настройки\n                // document.getElementById('cookie-settings-btn').addEventListener('click', () => {\n                //     document.getElementById('cookie-actions').style.display = 'none';\n                //     document.getElementById('cookie-settings-panel').style.display = 'block';\n                // });\n\n                // Разрешить все — то же что «Согласен»\n                document.getElementById('cookie-allow-all').addEventListener('click', () => {\n                    setConfirmed(true);\n                    loadMetrika();\n                    bannerElement.remove();\n                });\n\n                // Без метрики — принять cookies, но отказаться от метрики\n                document.getElementById('cookie-no-metrika').addEventListener('click', () => {\n                    setConfirmed(false);\n                    bannerElement.remove();\n                });\n\n                // Отказываюсь — стираем всё и уходим с сайта\n                document.getElementById('cookie-leave').addEventListener('click', (e) => {\n                    e.preventDefault();\n                    const href = e.currentTarget.href;\n                    document.cookie.split(';').forEach(c => {\n                        const key = c.split('=')[0].trim();\n                        document.cookie = `${key}=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/`;\n                    });\n                    try { localStorage.clear(); } catch {}\n                    try { sessionStorage.clear(); } catch {}\n                    window.location.href = href;\n                });\n\n                // Автоскрытие через 90 секунд\n                setTimeout(() => {\n                    if (bannerElement && bannerElement.parentNode) bannerElement.remove();\n                }, 90000);\n            };\n\n            // Инициализация\n            const init = () => {\n                if (!isConfirmed()) showBanner();\n            };\n\n            return { init };\n        })();\n\n        // Запуск на загрузке страницы\n        document.addEventListener('DOMContentLoaded', CookieBanner.init);\n    \n    </script>\n</body>\n</html>\n",
