 class=\"w-footer\">\n\t\t\t\t<span>&copy; Copyright\n                    <span id=\"text-year\"><!-- year[ -->2026<!-- ]year --></span>\n                    <a id=\"footerLink\" href=\"https://www.webnode.com/\" rel=\"nofollow\">Webnode Inc</a>. All rights reserved.</span>\n\t\t\t</div>\n\t\t</div>\n\n        <script type=\"text/javascript\">\n        /* <![CDATA[ */\n        (function () {\n            const DEFAULT_LANG = 'en';\n            const CLUSTER_TAG  = 'PGW'; // cluster identifier appended to debug timestamp\n\n            const translations = {\n                cz: {\n                    title:       'Chybová stránka Webnode',\n                    heading1:    'Ztratili jste se?',\n                    description: 'Je nám líto, ale stránka %domain% neexistuje. Tato adresa je ale dostupná pro Váš nový web!',\n                    domain:      'Chci se zaregistrovat a vytvořit si webové stránky <i>%domain%</i>',\n                    button:      '<b>Vytvořit webové stránky</b>',\n                },\n                en: {\n                    title:       'Webnode Error Page',\n                    heading1:    'Feel Lost?',\n                    description: \"We are sorry, but the page %domain% doesn't exist. But this address is available for your new website!\",\n                    domain:      'Register and create a website <i>%domain%</i>',\n                    button:      '<b>Create a website</b>',\n                },\n                pl: {\n                    title:       'Komunikat o błędzie usługi Webnode',\n                    heading1:    'Ojej, czyżbyśmy się zgubili?',\n                    description: 'Niestety, strona %domain% nie istnieje. Z drugiej strony oznacza to, że adres ten jest wolny i możesz z niego skorzystać.',\n                    domain:      'Stwórz stronę <i>%domain%</i>',\n                    button:      '<b>Stwórz stronę</b>',\n                },\n                de: {\n                    title:       'Webnode Fehlerseite',\n                    heading1:    'Verlaufen?',\n                    description: 'Es tut uns leid, aber die Seite %domain% existiert nicht. Die Adresse steht jedoch für Ihre Webseite zur Verfügung!',\n                    domain:      'Melden Sie sich an und erstellen Sie die Webseite <i>%domain%</i>',\n                    button:      '<b>Webseite erstellen</b>',\n                },\n                fr: {\n                    title:       \"Page d'erreur Webnode\",\n                    heading1:    'Vous êtes perdu ?',\n                    description: \"Nous sommes désolés, mais la page %domain% n'existe pas. Vous pouvez cependant utiliser cette adresse pour créer un nouveau site web !\",\n                    domain:      'Inscrivez-vous et créez le site <i>%domain%</i>',\n                    button:      '<b>Créer un site web</b>',\n                },\n                ru: {\n                    title:       'Страница 404',\n                    heading1:    'Заблудились?',\n                    description: 'Извините, но страница %domain% не существует. Вы можете создать свой собственный сайт с таким именем!',\n                    domain:      'Зарегистрируйтесь и создайте сайт <i>%domain%</i>',\n                    button:      '<b>Создать вебсайт</b>',\n                },\n                uk: {\n                    title:       'Сторінка 404',\n                    heading1:    'Заблукали?',\n                    description: \"Вибачте, але сторінка %domain% не існує. Ви можете створити свій власний сайт з таким ім'ям!\",\n                    domain:      'Зареєструйтесь і створіть сайт <i>%domain%</i>',\n                    button:      '<b>Створити сайт</b>',\n                },\n                es: {\n                    title:       'Webnode - Pagina de Error',\n                    heading1:    '¿Te sientes perdido?',\n                    description: 'Lo sentimos, pero la página %domain% no existe. Sin embargo, la dirección está libre, ¡así que puedes usarla en tu web!',\n                    domain:      'Registra y crea tu web <i>%domain%</i>',\n                    button:      '<b>Crea un sitio web</b>',\n                },\n                it: {\n                    title:       'Pagina di errore Webnode',\n                    heading1:    'La pagina non è esitente',\n                    description: 'Siamo spiacenti, la pagina %domain% non è esistente. Questo indirizzo è disponibile per essere registrato.',\n                    domain:      'Registra e crea il sito web <i>%domain%</i>',\n                    button:      '<b>Crea un sito web</b>',\n                },\n                tr: {\n                    title:       'Webnode hata sayfası',\n                    heading1:    'Bir sorun mu yaşıyorsun?',\n                    description: 'Üzgünüz, ama %domain% bulunamıyor. Fakat bu adres yeni bir web sitesi için uygundur!',\n                    domain:      'Kaydol ve bir web site oluştur <i>%domain%</i>',\n                    button:      '<b>Web site oluştur</b>',\n                },\n                sk: {\n                    title:       'Chybová stránka Webnode',\n                    heading1:    'Stratili ste sa?',\n                    description: 'Je nám ľúto, ale stránka %domain% neexistuje. Táto adresa je však voľná pre Váš nový web!',\n                    domain:      'Chcem sa zaregistrovať a vytvoriť si webové stránky <i>%domain%</i>',\n                    button:      '<b>Vytvoriť webové stránky</b>',\n                },\n                pt: {\n                    title:       'Página de Erro da Webnode',\n                    heading1:    'Está perdido?',\n                    description: 'Lamentamos, mas a página %domain% não existe. Este endereço está disponível para o seu novo site!',\n                    domain:      'Registe-se e crie um site <i>%domain%</i>',\n                    button:      '<b>Crie um site</b>',\n                },\n                'pt-br': {\n                    title:       'Webnode Página de erro',\n                    heading1:    'Sente-se perdido?',\n                    description: 'Lamentamos, mas a página %domain% não existe. Mas este endereço está disponível para o seu novo projeto!',\n                    domain:      'Registre-se e crie um website <i>%domain%</i>',\n                    button:      '<b>Crie seu site</b>',\n                },\n                sv: {\n                    title:       'Webnode Error-sida',\n                    heading1:    'Gått vilse?',\n                    description: 'Vi beklagar, men sidan %domain% existerar inte. Men denna adressen är tillgänglig för din nya hemsida!',\n                    domain:      'Registrera och skapa en hemsida <i>%domain%</i>',\n                    button:      '<b>Skapa en hemsida</b>',\n                },\n                nl: {\n                    title:       'De pagina bestaat niet',\n                    heading1:    'Bent u de weg kwijt?',\n                    description: 'Het spijt ons, maar de pagina %domain% bestaat niet. Maar u kunt de naam voor uw nieuwe website gebruiken.',\n                    domain:      'Meld u aan en creëer je eigen website <i>%domain%</i>',\n                    button:      '<b>Creëer een website</b>',\n                },\n                el: {\n                    title:       'Webnode | Η σελίδα δε βρέθηκε',\n                    heading1:    'Χαθήκατε;',\n                    description: 'Λυπούμαστε, αλλά η σελίδα %domain% δεν υπάρχει. Μπορείτε να χρησιμοποιήσετε τη διεύθυνση για τη νέα σας ιστοσελίδα!',\n                    domain:      'Εγγραφείτε και αποκτήστε την ιστοσελίδα <i>%domain%</i>',\n                    button:      '<b>Δημιουργήστε μία ιστοσελίδα</b>',\n                },\n                hu: {\n                    title:       'Webnode hibaoldal',\n                    heading1:    'Eltévedtél?',\n                    description: 'Sajnáljuk, de a(z) %domain% weboldal nem létezik. Nyugodtan regisztrálhatod saját oldalad ezzel a webcímmel!',\n                    domain:      'Regisztrálj, és hozd létre <i>%domain%</i> weboldaladat!',\n                    button:      '<b>Készítsd el oldaladat</b>',\n                },\n                ko: {\n                    title:       'Webnode 오류 페이지',\n                    heading1:    '길을 잃어버리셨나요?',\n                    description: '죄송합니다, 현재 %domain% 페이지는 존재하지 않습니다. 하지만 동일한 주소로 새로운 홈페이지를 제작할 수 있습니다!',\n                    domain:      '등록하여 <i>%domain%</i> 홈페이지를 제작해 보세요.',\n                    button:      '<b>홈페이지를 제작해 보세요</b>',\n                },\n                no: {\n                    title:       'Webnode sin feilmeldingsside',\n                    heading1:    'Oi sann! Det var vel ikke hit du skulle, eller?',\n                    description: 'Vi beklager, men siden %domain% finnes ikke. Når det er sagt, så kan du godt bruke denne nettadressen til å lage din nye hjemmeside!',\n                    domain:      'Registrer hjemmesiden <i>%domain%</i>',\n                    button:      '<b>Lag din egen hjemmeside</b>',\n                },\n                ro: {\n                    title:       'Pagina de eroare a Webnode',\n                    heading1:    'V-ați pierdut?',\n                    description: 'Ne pare rău, dar pagina %domain% nu există. Puteți utiliza această adresă pentru noul dvs. site!',\n                    domain:      'Înregistrați-vă și creați site-ul <i>%domain%</i>',\n                    button:      '<b>Creați un site</b>',\n                },\n                ja: {\n                    title:       'Webnodeエラーページ',\n                    heading1:    '迷子ですか？',\n                    description: 'ウェブサイト %domain% は存在しません。でもこのアドレスを使って新しくウェブサイトを作りませんか？',\n                    domain:      '√ <i>%domain%</i> でウェブサイトを新規作成',\n                    button:      '<b>今すぐ始める</b>',\n                },\n                'en-us': {\n                    heading1:    'Feel Lost?',\n                    description: \"We are sorry, but the page %domain% doesn't exist. But this address is available for your new website!\",\n                    domain:      'Register and create a website <i>%domain%</i>',\n                    button:      '<b>Create a website</b>',\n                },\n            };\n\n            function normalizeLanguage(lang) {\n                lang = lang.toLowerCase();\n                if (!['pt-br', 'zh-cn', 'zh-tw', 'en-us'].includes(lang)) {\n                    lang = lang.slice(0, 2);\n                }\n                return lang === 'cs' ? 'cz' : lang;\n            }\n\n            const domain = window.location.hostname;\n            const lang   = normalizeLanguage(\n                window.navigator.userLanguage || window.navigator.browserLanguage || window.navigator.language || DEFAULT_LANG\n            );\n            const text = translations[lang] || translations[DEFAULT_LANG];\n\n            ['title', 'heading1', 'description', 'domain', 'button'].forEach(function (id) {\n                const el = id === 'title'\n                    ? document.querySelector('title')\n                    : document.getElementById('text-' + id);\n                if (el && text[id]) {\n                    el.innerHTML = text[id].replace('%domain%', domain);\n                }\n            });\n\n            document.getElementById('text-year').innerHTML = new Date().getFullYear();\n\n            window.addEventListener('load', function () {\n                const now    = new Date();\n                const date   = now.toLocaleDateString('en-GB');\n                const time   = now.toLocaleTimeString('en-GB');\n                const tz     = Intl.DateTimeFormat().resolvedOptions().timeZone;\n                const offset = -now.getTimezoneOffset() / 60;\n                const clusterSuffix = CLUSTER_TAG ? '[' + CLUSTER_TAG + ']' : '';\n                const status = performance?.getEntriesByType('navigation')[0]?.responseStatus ?? '';\n\n                document.getElementById('currentDateTime').innerText =\n                    `${date} ${time} GMT${offset >= 0 ? '+' : ''}${offset} [${tz}]${clusterSuffix}`;\n                document.getElementById('currentURL').innerText =\n                    `${window.location.href} [${status}]`;\n            });\n        }());\n        /* ]]> */\n        </script>\n    </body>\n</html>\n",
        "bodyEncoding": "utf8"
      }
    }
  ]
