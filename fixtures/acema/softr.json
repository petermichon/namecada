        "body": "<style type=\"text/css\">\n\n    @font-face {\n        font-family: 'Inter';\n        font-style: normal;\n        font-weight: 100 900;\n        font-display: swap;\n        src: url('https://assets.softr-files.com/fonts/inter.woff2') format('woff2');\n    }\n\n    @font-face {\n        font-family: 'Satoshi';\n        font-style: normal;\n        font-weight: 100 900;\n        font-display: swap;\n        src: url('https://assets.softr-files.com/fonts/satoshi.woff2') format('woff2');\n    }\n\n    /* Copied from softr-studio-ui (src/assets/styles/global/_colors.scss and _custom-properties.scss).\n       Only the tokens this page uses; keep in sync with Studio when they change. */\n    :root {\n        --gray-4: #dfe2e6;\n        --gray-8: #555D6F;\n        --gray-9: #282f40;\n        --gray-10: #18202d;\n        --gray-11: #111822;\n        --white: #FFFFFF;\n\n        --text-primary: var(--gray-11);\n        --text-secondary: var(--gray-8);\n        --text-on-solid: var(--white);\n\n        --border-secondary-alpha: rgba(24, 32, 45, 0.05);\n\n        --effect-hover-brighten: rgba(255, 255, 255, 0.08);\n        --button-primary: linear-gradient(180deg, var(--gray-9) 14%, var(--gray-10) 100%);\n        --button-primary-hover: linear-gradient(0deg, var(--effect-hover-brighten) 0%, var(--effect-hover-brighten) 100%), linear-gradient(180deg, var(--gray-9) 14%, var(--gray-10) 100%);\n        --button-primary-box-shadow: 0 1px 1px 0 rgba(255, 255, 255, 0.15) inset, 0 0 1px 0 rgba(0, 0, 0, 0.24) inset, 0 1px 3px -1px rgba(0, 0, 0, 0.08);\n\n        --swFontFamily: Inter, system-ui, sans-serif;\n        --swFontFamilyHeading: Satoshi, system-ui, sans-serif;\n        --fontWeight: 400;\n        --boldFont: 500;\n        --boldestFont: 700;\n\n        --borderRadiusL: 16px;\n        --borderRadiusM: 8px;\n\n        --generic-spacing-1-5: 6px;\n        --generic-spacing-4: 16px;\n        --generic-spacing-6: 24px;\n        --generic-spacing-8: 32px;\n        --generic-spacing-12: 48px;\n    }\n\n    body {\n        margin: 0;\n        font-family: var(--swFontFamily);\n        color: var(--text-primary);\n    }\n\n    #block-cant-find-app {\n        background: var(--white);\n    }\n\n    .container {\n        display: flex;\n        box-sizing: border-box;\n        min-height: 100vh;\n        padding: var(--generic-spacing-4);\n    }\n\n    .error-text-wrapper {\n        box-sizing: border-box;\n        flex: 1 1 50%;\n        display: flex;\n        flex-direction: column;\n        justify-content: center;\n        padding: 0 var(--generic-spacing-12);\n    }\n\n    .error-text-content {\n        width: 100%;\n        max-width: 441px;\n        margin: 0 auto;\n    }\n\n    .company-title::before {\n        content: \"\";\n        display: inline-flex;\n        background-image: url(\"/assets/images/softr-title-logo.svg\");\n        background-repeat: no-repeat;\n        height: 34px;\n        width: 123px;\n        /* 64px: Studio has no 64px spacing token, so it's built from two (48 + 16) */\n        margin-bottom: calc(var(--generic-spacing-12) + var(--generic-spacing-4));\n    }\n\n    /* Studio sw-text-headline at 36/48, the size its Storybook label documents (the class itself is 48/56) */\n    .error-title {\n        font-family: var(--swFontFamilyHeading);\n        font-size: 2.25rem;\n        font-weight: var(--boldestFont);\n        line-height: 3rem;\n        letter-spacing: -0.72px;\n        margin-bottom: var(--generic-spacing-4);\n    }\n\n    /* Studio sw-text-body-large size, at regular weight */\n    .error-text {\n        max-width: 441px;\n        font-size: 0.875rem;\n        font-weight: var(--fontWeight);\n        line-height: 1.25rem;\n        color: var(--text-secondary);\n        margin-bottom: var(--generic-spacing-6);\n    }\n\n    /* A little more room above the button than between the paragraphs */\n    .error-text:last-of-type {\n        margin-bottom: var(--generic-spacing-8);\n    }\n\n    /* Studio swButton, buttonTheme=\"primary\", buttonSize=\"large\", buttonIcon=\"un:arrow-right\", iconDirection=\"right\" */\n    .home-button {\n        display: inline-flex;\n        align-items: center;\n        gap: var(--generic-spacing-1-5);\n        min-height: 2.5rem;\n        border-radius: var(--borderRadiusM);\n        padding: 0 var(--generic-spacing-4);\n        border: none;\n        background: var(--button-primary);\n        box-shadow: var(--button-primary-box-shadow);\n        cursor: pointer;\n        font-family: var(--swFontFamily);\n        text-decoration: none;\n        font-size: 0.875rem;\n        font-weight: var(--boldFont);\n        line-height: 1.5rem;\n        color: var(--text-on-solid);\n    }\n\n    /* Studio icon size L */\n    .home-button svg {\n        width: 20px;\n        height: 20px;\n        flex-shrink: 0;\n    }\n\n    .home-button:hover {\n        background: var(--button-primary-hover);\n    }\n\n    .home-button:active {\n        background: var(--gray-11);\n        box-shadow: none;\n    }\n\n    /* Template showcase: screenshots tiled at 45 degrees in a rounded frame, like Softr's sign-in page.\n       Columns drift slowly in alternating directions. */\n    .mosaic-panel {\n        --mosaic-duration: 260s;\n        --mosaic-gap: var(--generic-spacing-4);\n        position: relative;\n        flex: 1 1 50%;\n        overflow: hidden;\n        container-type: size;\n        border: 1px solid var(--border-secondary-alpha);\n        border-radius: var(--borderRadiusL);\n        background-color: var(--gray-4);\n        /* Keep the gray inside the border, so the outline sits on the white page and stays light */\n        background-clip: padding-box;\n        pointer-events: none;\n    }\n\n    .mosaic-clip {\n        position: absolute;\n        inset: 0;\n        overflow: hidden;\n    }\n\n    /* A square, rotated 45 degrees and centred, big enough to cover the frame's corners */\n    .mosaic {\n        --mosaic-size: calc((100cqw + 100cqh) * 0.75);\n        position: absolute;\n        top: 50%;\n        left: 50%;\n        width: var(--mosaic-size);\n        height: var(--mosaic-size);\n        transform: translate(-50%, -50%) rotate(45deg);\n        display: grid;\n        grid-template-columns: repeat(6, 1fr);\n        gap: var(--mosaic-gap);\n    }\n\n    /* Each column holds its tiles twice; moving it by half loops seamlessly */\n    .mosaic-track {\n        display: flex;\n        flex-direction: column;\n        gap: var(--mosaic-gap);\n        animation: mosaic-up var(--mosaic-duration) linear infinite;\n    }\n\n    .mosaic-track-down {\n        animation-name: mosaic-down;\n    }\n\n    @keyframes mosaic-up {\n        from { transform: translateY(0); }\n        to { transform: translateY(calc(-50% - var(--mosaic-gap) / 2)); }\n    }\n\n    @keyframes mosaic-down {\n        from { transform: translateY(calc(-50% - var(--mosaic-gap) / 2)); }\n        to { transform: translateY(0); }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n        .mosaic-track {\n            animation: none;\n        }\n    }\n\n    /* 600x630 screenshots, pinned to the top at full width so nothing at their edges is cut off */\n    .mosaic-tile {\n        flex-shrink: 0;\n        aspect-ratio: 600 / 630;\n        border-radius: var(--borderRadiusM);\n        background-size: 100%;\n        background-position: top center;\n    }\n\n    .tile-online-communities { background-image: url(\"/assets/images/templates/online-communities.jpg\"); }\n    .tile-resource-directories { background-image: url(\"/assets/images/templates/resource-directories.jpg\"); }\n    .tile-crms { background-image: url(\"/assets/images/templates/crms.jpg\"); }\n    .tile-project-management { background-image: url(\"/assets/images/templates/project-management.jpg\"); }\n    .tile-landing-pages { background-image: url(\"/assets/images/templates/landing-pages.jpg\"); }\n    .tile-client-portals { background-image: ur