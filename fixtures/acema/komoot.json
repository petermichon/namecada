: 20px;\n        margin-bottom: 24px;\n        border-bottom: 1px solid var(--color-border-subtle);\n      }\n\n      header .header-logo-link {\n        display: inline-block;\n        line-height: 0;\n        text-decoration: none;\n        color: inherit;\n      }\n\n      header .header-logo-link:focus-visible {\n        outline: 2px solid var(--color-link);\n        outline-offset: 4px;\n        border-radius: 4px;\n      }\n\n      header .header-logo {\n        display: inline-flex;\n        align-items: center;\n        gap: 10px;\n      }\n\n      header .header-logo-mark {\n        width: 32px;\n        height: 32px;\n        flex-shrink: 0;\n        color: var(--color-link);\n      }\n\n      header .header-logo-mark path {\n        fill: currentColor;\n      }\n\n      header .header-logo-type {\n        width: 84px;\n        height: 16px;\n        flex-shrink: 0;\n        color: var(--color-text);\n      }\n\n      header .header-logo-type path {\n        fill: currentColor;\n      }\n\n      h1 {\n        font-family: var(--font-heading);\n        font-size: clamp(1.25rem, 2.5vw, 1.5rem);\n        font-weight: 700;\n        line-height: 1.25;\n        color: var(--color-text);\n        margin-top: 0;\n        letter-spacing: -0.01em;\n      }\n\n      article {\n        margin-top: 28px;\n        padding-top: 28px;\n        border-top: 1px solid var(--color-border-subtle);\n      }\n\n      article:first-of-type {\n        margin-top: 0;\n        padding-top: 0;\n        border-top: none;\n      }\n\n      article p {\n        color: var(--color-text-muted);\n        font-weight: 400;\n      }\n\n      pre {\n        color: var(--color-text);\n        font-size: 11px;\n        font-family: Menlo, ui-monospace, monospace;\n        overflow: auto;\n        margin-top: 40px;\n        padding: 12px;\n        background: var(--color-border-subtle);\n        border-radius: 4px;\n      }\n    </style>\n  </head>\n\n  <body>\n    <header>\n      <a href=\"/\" 