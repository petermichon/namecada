ion value=\"th\" >ไทย</option>\n              \n                <option value=\"km\" >ភាសាខ្មែរ</option>\n              \n                <option value=\"pl\" >Polski</option>\n              \n                <option value=\"pt\" >Português</option>\n              \n                <option value=\"pt-br\" >Português Brasileiro</option>\n              \n                <option value=\"rap\" >Rapa Nui</option>\n              \n                <option value=\"ro\" >Română</option>\n              \n                <option value=\"ru\" >Русский</option>\n              \n                <option value=\"nso\" >Sepedi</option>\n              \n                <option value=\"tn\" >Setswana</option>\n              \n                <option value=\"sk\" >Slovenčina</option>\n              \n                <option value=\"sl\" >Slovenščina</option>\n              \n                <option value=\"sr\" >Српски</option>\n              \n                <option value=\"fi\" >Suomi</option>\n              \n                <option value=\"sv\" >Svenska</option>\n              \n                <option value=\"vi\" >Tiếng Việt</option>\n              \n                <option value=\"tr\" >Türkçe</option>\n              \n                <option value=\"uk\" >Українська</option>\n              \n                <option value=\"zh-cn\" >简体中文</option>\n              \n                <option value=\"zh-tw\" >繁體中文</option>\n              \n              </select>\n            </form>\n          </li>\n        </ul>\n      </div>\n    </div>\n    \n\n    \n<!-- templates/modal-login.html block -->\n\t    <div class=\"modal hide fade in\" id=\"login-dialog\" style=\"width: 450px\">\n        <form method=\"post\" action=\"/login/\">\n          <fieldset>\n            <div class=\"modal-header\">\n              <a href=\"#\" data-dismiss=\"modal\" class=\"close\">x\n              </a>\n\t      <h3>Sign in</h3>\n            </div>\n            <div class=\"modal-body\">\n            \n              <div class=\"control-group\">\n\t\t      <label class=\"control-label\" for=\"username\">Username\n                </label>\n                <div class=\"controls\">\n                  <input class=\"username\" type=\"text\" name=\"username\" maxlength=\"30\" />\n                </div>\n              </div>\n              <div class=\"control-group\">\n\t\t            <label class=\"control-label\" for=\"password\">Password\n                </label>\n                <div class=\"controls\">\n                  <input type=\"password\" name=\"password\" class=\"password\" />\n                </div>\n              </div>\n              \n            </div>\n            <div class=\"modal-footer\">\n              <span class=\"error\">\n              </span>\n              <div class=\"buttons-right\">\n                <button class=\"button primary\" type=\"submit\">Sign in</button> \n                \n\t\t<a data-control=\"registration\">Or Join Scratch</a>\n                \n              </div>\n            </div>\n           \n          </fieldset>\n        </form>\n        <iframe class=\"iframeshim\" frameborder=\"0\" scrolling=\"no\"><html><head></head><body></body></html></iframe>\n      </div>\n<!-- end templates/modal-login.html -->\n\n    \n        <div id=\"registration\" class=\"registration modal hide fade\" data-backdrop=\"static\">\n          <iframe class=\"iframeshim\" frameborder=\"0\" scrolling=\"no\"><html><head></head><body></body></html></iframe>\n        </div>\n    \n\n    \n    \n\n    \n    \n\n    <script type=\"text/javascript\" src=\"//cdn.scratch.mit.edu/scratchr2/static/__9df8705ead146d0ff4b9ef4e86644347__//js/jquery-ui.min.js\"></script>\n\n    <script type=\"text/javascript\" src=\"//cdn.scratch.mit.edu/scratchr2/static/__9df8705ead146d0ff4b9ef4e86644347__/js/main.js\" charset=\"utf-8\"></script>\n    <script type=\"text/javascript\" src=\"//cdn.scratch.mit.edu/scratchr2/static/__9df8705ead146d0ff4b9ef4e86644347__/js/base.js\" charset=\"utf-8\"></script>\n    <script type=\"text/javascript\" src=\"//cdn.scratch.mit.edu/scratchr2/static/__9df8705ead146d0ff4b9ef4e86644347__/js/lazyload.js\" charset=\"utf-8\"></script>\n    \n<!-- templates/profiles/profile_detail.html block js -->\n\n<script src=\"//cdn.scratch.mit.edu/scratchr2/static/__9df8705ead146d0ff4b9ef4e86644347__//js/lib/jquery.ui.widget.js\"></script>\n<script src=\"//cdn.scratch.mit.edu/scratchr2/static/__9df8705ead146d0ff4b9ef4e86644347__//js/lib/blueimp-jquery-file-upload/jquery.iframe-transport.js\"></script>\n<script src=\"//cdn.scratch.mit.edu/scratchr2/static/__9df8705ead146d0ff4b9ef4e86644347__//js/lib/blueimp-jquery-file-upload/jquery.fileupload.js\"></script>\n<script>\n  $(document).ready(function() {\n    scratch.notifications.loadActivity($('#activity-feed'), {'friends': false, 'max': 6, 'actor': 'acema'});\n  });\n    sessionStorage.setItem(\"explore_by\", \"creator\")\n    sessionStorage.removeItem(\"gallery_id\")\n</script>\n<!-- end block js -->\n\n    \n\n    \n\n\n\n<script type=\"text/template\" id=\"template-collection-count\">\n  <%- count %>\n</script>\n\n<script type=\"text/template\" id=\"template-comment-actions\">\n<% if (can_delete) { %>\n  <% if (is_staff && comment_user == current_user) { %>\n    <span data-control=\"delete\" class=\"actions report\">Delete</span>\n  <% } else if (type != \"gallery\" || comment_user == current_user) { %>\n    <span data-control=\"delete\" class=\"actions report\">Delete</span>\n  <% } %>\n<% } %>\n<% if (current_user != comment_user) { %>\n  <span data-control=\"report\" class=\"actions report\">\n  <% if (student_of_educator) { %>\n    Delete\n  <% } else { %>\n    Report\n  <% } %></span>\n<% } %>\n</script>\n\n<script type=\"text/template\" id=\"template-modal-login\">\n<div class=\"modal hide fade in\" id=\"login-dialog\" style=\"width: 450px\">\n  <form method=\"post\" action=\"/login/\">\n    <fieldset>\n      <div class=\"modal-header\">\n        <a href=\"#\" data-dismiss=\"modal\" class=\"close\">x\n        </a>\n        <h3>Login</h3>\n      </div>\n      <div class=\"modal-body\">\n        <div class=\"control-group\">\n        <label class=\"control-label\" for=\"username\">Username\n          </label>\n          <div class=\"controls\">\n            <input id=\"username\" type=\"text\" name=\"username\" maxlength=\"30\" />\n          </div>\n        </div>\n        <div class=\"control-group\">\n        <label class=\"control-label\" for=\"password\">Password\n          </label>\n          <div class=\"controls\">\n            <input type=\"password\" name=\"password\" id=\"password\" />\n          </div>\n        </div>\n      </div>\n      <div class=\"modal-footer\">\n        <span class=\"error\">\n        </span>\n        <span class=\"button primary\" id=\"sign-in\" data-control=\"site-login\">\n        <span>{% trans \"Sign in\" $}\n          </span>\n        </span>\n      </div>\n    </fieldset>\n  </form>\n</div>\n</script>\n\n<script type=\"text/template\" id=\"template-comment-reply\">\n  <form>\n    <div class=\"control-group tooltip right\">\n      <textarea name=\"content\"></textarea>\n      \n      <span class=\"hovertext error\" data-control=\"error\" data-content=\"comment-error\"><span class=\"arrow\"></span><span class=\"text\"></span></span>\n      <span class=\"small-text\">You have <span id=\"chars-left-<%- comment_id %>\">500</span> characters left.</span>\n    </div>\n    <div class=\"control-group\">\n        <div class=\"button small\" data-parent-thread=\"<%- thread_id %>\" data-commentee-id=\"<%- commentee_id %>\" data-control=\"modal-login\"><a href=\"#null\">Post</a></div>\n        <div class=\"button small grey\" data-control=\"cancel\"><a href=\"#null\">Cancel</a></div>\n      <span class=\"notification\"></span>\n    </div>\n  </form>\n</script>\n\n<script type=\"text/template\" id=\"template-deletion-canceled\">\n<div class=\"deletion-canceled\">\n  <div class=\"form\">\n    <p>\n    Your account was scheduled for deletion but you logged in. Your account has been reactivated. If you didn’t request for your account to be deleted, you should <a href=\"/accounts/password_change/\">change your password</a> to make sure your account is secure. \n    </p>\n  </div>\n</div>\n</script>\n\n<script type=\"text/template\" id=\"template-unsupported-browser\">\n  <div class=\"unsupported-browser banner\" data-cue=\"unsupported_browser\">\n    <div class=\"container\">\n      <span>Scratch works best on newer browsers. We suggest you upgrade to <a href=\"/info/faq/#requirements\">a supported browser</a>, <a href=\"/scratch2download/\">download the offline editor</a>, <a href=\"https://en.scratch-wiki.info/wiki/List_of_Bug_Workarounds\">or read about common workarounds</a>.</span>\n      <div class=\"close\">x</div>\n    </div>\n  </div>\n</script>\n\n\n\n<script type=\"text/template\" id=\"template-bio-status-content\">\n  \n    <p></p>\n  \n</script>\n\n<script type=\"text/template\" id=\"template-project-collection\">\n  <% _.each(collection, function(project) { %>\n    <li>\n      <div class=\"project thumb\" data-id=\"<%- project.id %>\">\n        <img src=\"<%- project.thumbnail_url %>\">\n        <span class=\"title\">\n          <a href=\"/projects/<%- project.id %>\"><%- project.title %></a>\n        </span>\n      </div>\n    </li>\n  <% }); %>\n</script>\n\n<script type=\"text/template\" id=\"template-modal-container\">\n  <div class=\"modal-header\">\n    <span class=\"close\" data-dismiss=\"modal\" aria-hidden=\"true\">×</span>\n    <h3 id=\"myModalLabel\">My Shared Projects</h3>\n    <div class=\"feature-label\">\n      <label for=\"feature-label\">Label</label>\n      <select name=\"feature-label\">\n        <option value=\"\" selected=\"selected\">Featured Project</option>\n      \n        <option value=\"0\" >Featured Tutorial</option>\n      \n        <option value=\"1\" >Work In Progress</option>\n      \n        <option value=\"2\" >Remix This!</option>\n      \n        <option value=\"3\" >My Favorite Things</option>\n      \n        <option value=\"4\" >Why I Scratch</option>\n      </select>\n    </div>\n  </div>\n  <div data-content=\"modal-body\" class=\"modal-body\">\n    \n    <div class=\"empty-field\">\n      <h4><a href=\"/projects/editor/\">Create a project</a> and share it</h4>\n      <span>You don't have any shared projects to feature yet</span>\n    </div>\n    \n  </div>\n  <div class=\"modal-footer\">\n    <button class=\"btn\" data-dismiss=\"modal\" aria-hidden=\"true\">Cancel</button>\n    <button class=\"btn blue btn-primary\" data-control=\"save\">OK</button>\n  </div>\n</div>\n</script>\n\n<script type=\"text/template\" id=\"template-report\">\n  <div class=\"profile-report\">\n      Please choose the section of this user’s profile that you feel is disrespectful, inappropriate, or has otherwise broken the <a href=\"/community_guidelines\" target=\"_blank\">Scratch Community Guidelines.</a> \n    <br>\n    <p class=\"errors\">Please select the inappropriate part of the page.</p>\n    <form class=\"form-horizontal\" id='report_form'>\n      <input type=\"radio\" id='radio_username' name=\"report_value\" value=\"username\">Username</input>\n      <br>\n      <input type=\"radio\" id='radio_icon' name=\"report_value\" value=\"icon\">Icon</input>\n      <br>\n      <input type=\"radio\" id='radio_description' name=\"report_value\" value=\"description\">About Me</input>\n      <br>\n      <input type=\"radio\" id='radio_working_on' name=\"report_value\" value=\"working_on\">What I'm Working On</input>\n    </form>\n    <div>\n      Did this user make comments, projects, or studios that broke the Community Guidelines? Please click the “report” button on the individual comments, projects, or studios.\n    </div>\n  </div>\n</script>\n\n<script type=\"text/template\" id=\"template-thanks\">\n<div class=\"profile-report\">\n  <div class=\"form\">\n    <div>Thank you. We have received your report. The Scratch Team will review this user based on the Scratch community guidelines.\n    </div>\n  </div>\n</div>\n</script>\n\n\n\n\n\n\n\n    \n\n    <!-- load javascript translation catalog, and javascript fuzzy date library -->\n    <script type=\"text/javascript\" src=\"/jsi18n/\"></script>\n    <script type=\"text/javascript\" src=\"//cdn.scratch.mit.edu/scratchr2/static/__9df8705ead146d0ff4b9ef4e86644347__/js/lib/jquery.timeago.settings.js\"></script>\n\n    \n    <script type=\"text/javascript\" src=\"//cdn.scratch.mit.edu/scratchr2/static/__9df8705ead146d0ff4b9ef4e86644347__//js/apps/registration/main.js\"></script>\n    \n\n    <script type=\"text/javascript\" src=\"//cdn.scratch.mit.edu/scratchr2/static/__9df8705ead146d0ff4b9ef4e86644347__//js/apps/global.js\"></script>\n    <script>\n      Scratch.NotificationPollTime = 300000;\n    </script>\n\n    \n<script src=\"//cdn.scratch.mit.edu/scratchr2/static/__9df8705ead146d0ff4b9ef4e86644347__//js/apps/userprofile/main.js\"></script>\n<script src=\"//cdn.scratch.mit.edu/scratchr2/static/__9df8705ead146d0ff4b9ef4e86644347__//js/apps/userprofile/models.js\"></script>\n<script src=\"//cdn.scratch.mit.edu/scratchr2/static/__9df8705ead146d0ff4b9ef4e86644347__//js/apps/userprofile/views.js\"></script>\n<script src=\"//cdn.scratch.mit.edu/scratchr2/static/__9df8705ead146d0ff4b9ef4e86644347__//js/apps/userprofile/models/user-detail.js\"></script>\n\n\n    \n    <script>\n    $(document).on(\"accountnavready\", function(e){\n        $('#topnav .messages').notificationsAlert();\n    });\n    </script>\n    \n    <script type=\"text/javascript\">\n      var today = new Date();\n      if (today.getDate() === 1 && today.getMonth() === 3) {\n        document.write(';');\n      }\n    </script>\n  </body>\n  <!-- Site Version: 3.2026.11.24.release.1_2026_11_24_10_10 -->\n</html>\n",
        "bodyEncoding": "utf8"
      }
    }
