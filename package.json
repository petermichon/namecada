{
	"name": "domain-browser",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=20.19"
	},
	"workspaces": [
		"web"
	],
	"scripts": {
		"dev": "concurrently -k -n web,server -c blue,green \"npm:dev:web\" \"npm:server:dev\"",
		"dev:web": "npm run dev -w @domain-browser/web",
		"dev:android": "adb reverse tcp:5173 tcp:5173 && npm run dev:web",
		"build": "npm run build -w @domain-browser/web",
		"preview": "npm run preview -w @domain-browser/web",
		"test": "npm run test -w @domain-browser/web",
		"check": "npm run check -w @domain-browser/web",
		"lint": "npm run lint -w @domain-browser/web",
		"format": "npm run format -w @domain-browser/web && npm run server:fmt",
		"server:dev": "go -C server run ./cmd/domainbrowser serve",
		"server:watch": "air -c .air.toml",
		"server:build": "go -C server build -o bin/domainbrowser ./cmd/domainbrowser",
		"server:test": "go -C server test ./...",
		"server:lint": "go -C server vet ./...",
		"server:fmt": "gofmt -w server",
		"server:tidy": "go -C server mod tidy",
		"verify": "npm run check && npm test && npm run lint && npm run server:lint && npm run server:test",
		"prepare": "husky"
	},
	"lint-staged": {
		"web/**/*.{js,cjs,mjs,ts,svelte}": [
			"prettier --write",
			"eslint --fix"
		],
		"web/**/*.{json,css,html,md}": "prettier --write",
		"server/**/*.go": "gofmt -w"
	},
	"devDependencies": {
		"concurrently": "^10.0.6",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0"
	}
}
