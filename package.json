{
	"name": "namecada",
	"description": "A name availability report across domains, usernames and package registries.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/petermichon/namecada.git"
	},
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=20.19"
	},
	"workspaces": [
		"apps/web",
		"apps/desktop"
	],
	"scripts": {
		"dev": "concurrently -k -n web,server -c blue,green \"npm:dev:web\" \"npm:rust:serve\"",
		"dev:web": "npm run dev -w @namecada/web",
		"dev:host": "concurrently -k -n web,server -c blue,green \"npm run dev:host -w @namecada/web\" \"npm:rust:serve\"",
		"site:dev": "npm --prefix apps/site run dev",
		"site:dev:host": "npm --prefix apps/site run dev:host",
		"site:build": "npm --prefix apps/site run build",
		"build": "npm run build -w @namecada/web",
		"preview": "npm run preview -w @namecada/web",
		"test": "npm run test -w @namecada/web",
		"check": "npm run check -w @namecada/web",
		"lint": "npm run lint -w @namecada/web",
		"format": "npm run format -w @namecada/web && npm run rust:fmt",
		"rust:test": "cargo test --workspace",
		"rust:fmt": "cargo fmt --all && cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml",
		"rust:fmt:check": "cargo fmt --all -- --check && cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml -- --check",
		"rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings && cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings",
		"rust:clippy:core": "cargo clippy --workspace --all-targets -- -D warnings",
		"rust:build": "cargo build --release -p namecada",
		"tauri": "npm run tauri --workspace @namecada/desktop --",
		"tauri:dev": "npm run dev --workspace @namecada/desktop",
		"tauri:build": "npm run build --workspace @namecada/desktop",
		"android:dev": "bash scripts/android-dev.sh",
		"android:dev:host": "bash scripts/android-dev.sh --host",
		"android:sign": "bash scripts/android-sign.sh",
		"rust:serve": "cargo run -p namecada --bin serve",
		"probe": "cargo run -p namecada --bin probe --",
		"capture": "cargo run -p namecada --bin capture",
		"verify": "npm run check && npm test && npm run lint && npm run rust:fmt:check && npm run rust:clippy && npm run rust:test",
		"verify:ci": "npm run check && npm test && npm run lint && npm run rust:fmt:check && npm run rust:clippy:core && npm run rust:test",
		"prepare": "husky"
	},
	"lint-staged": {
		"apps/web/**/*.{js,cjs,mjs,ts,svelte}": [
			"prettier --write",
			"eslint --fix"
		],
		"apps/web/**/*.{json,css,html,md}": "prettier --write",
		"apps/site/**/*.{js,ts,css,html,md,json}": "prettier --write",
		"packages/**/*.rs": "rustfmt --edition 2021",
		"apps/cli/**/*.rs": "rustfmt --edition 2021",
		"apps/desktop/src-tauri/**/*.rs": "rustfmt --edition 2021"
	},
	"devDependencies": {
		"@tauri-apps/cli": "2.12.6",
		"concurrently": "^10.0.7",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.1"
	},
	"license": "MIT OR Apache-2.0"
}
