{
	"name": "domain-browser",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=20.19"
	},
	"workspaces": [
		"frontend"
	],
	"scripts": {
		"dev": "npm run dev -w @domain-browser/frontend",
		"dev:android": "adb reverse tcp:5173 tcp:5173 && npm run dev",
		"build": "npm run build -w @domain-browser/frontend",
		"preview": "npm run preview -w @domain-browser/frontend",
		"test": "npm run test -w @domain-browser/frontend",
		"check": "npm run check -w @domain-browser/frontend",
		"lint": "npm run lint -w @domain-browser/frontend",
		"format": "npm run format -w @domain-browser/frontend",
		"verify": "npm run check && npm test && npm run lint"
	}
}
