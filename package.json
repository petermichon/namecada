{
	"name": "domain-browser",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=20.19"
	},
	"workspaces": [
		"web"
	],
	"scripts": {
		"dev": "concurrently -k -n web,server -c blue,green \"npm:dev:web\" \"npm:rust:serve\"",
		"dev:web": "npm run dev -w @domain-browser/web",
		"dev:android": "adb reverse tcp:5173 tcp:5173 && adb reverse tcp:8080 tcp:8080 && npm run dev",
		"build": "npm run build -w @domain-browser/web",
		"preview": "npm run preview -w @domain-browser/web",
		"test": "npm run test -w @domain-browser/web",
		"check": "npm run check -w @domain-browser/web",
		"lint": "npm run lint -w @domain-browser/web",
		"format": "npm run format -w @domain-browser/web && npm run rust:fmt",
		"rust:test": "cargo test --manifest-path rust/Cargo.toml --workspace",
		"rust:fmt": "cargo fmt --manifest-path rust/Cargo.toml --all",
		"rust:fmt:check": "cargo fmt --manifest-path rust/Cargo.toml --all -- --check",
		"rust:clippy": "cargo clippy --manifest-path rust/Cargo.toml --workspace --all-targets -- -D warnings",
		"rust:build": "cargo build --release --manifest-path rust/Cargo.toml -p domain-browser",
		"rust:serve": "cargo run --manifest-path rust/Cargo.toml -p domain-browser -- serve --manifest fixtures/sources.json",
		"verify": "npm run check && npm test && npm run lint && npm run rust:fmt:check && npm run rust:clippy && npm run rust:test",
		"prepare": "husky"
	},
	"lint-staged": {
		"web/**/*.{js,cjs,mjs,ts,svelte}": [
			"prettier --write",
			"eslint --fix"
		],
		"web/**/*.{json,css,html,md}": "prettier --write",
		"rust/**/*.rs": "rustfmt --edition 2021"
	},
	"devDependencies": {
		"concurrently": "^10.0.6",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0"
	}
}
