{
	"name": "namecada",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=20.19"
	},
	"workspaces": [
		"web"
	],
	"scripts": {
		"dev": "concurrently -k -n web,server -c blue,green \"npm:dev:web\" \"npm:rust:serve\"",
		"dev:web": "npm run dev -w @namecada/web",
		"dev:host": "concurrently -k -n web,server -c blue,green \"npm run dev:host -w @namecada/web\" \"npm:rust:serve\"",
		"build": "npm run build -w @namecada/web",
		"preview": "npm run preview -w @namecada/web",
		"test": "npm run test -w @namecada/web",
		"check": "npm run check -w @namecada/web",
		"lint": "npm run lint -w @namecada/web",
		"format": "npm run format -w @namecada/web && npm run rust:fmt",
		"rust:test": "cargo test --manifest-path rust/Cargo.toml --workspace",
		"rust:fmt": "cargo fmt --manifest-path rust/Cargo.toml --all && cargo fmt --manifest-path src-tauri/Cargo.toml",
		"rust:fmt:check": "cargo fmt --manifest-path rust/Cargo.toml --all -- --check && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
		"rust:clippy": "cargo clippy --manifest-path rust/Cargo.toml --workspace --all-targets -- -D warnings && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
		"rust:build": "cargo build --release --manifest-path rust/Cargo.toml -p namecada",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build",
		"rust:serve": "cargo run --manifest-path rust/Cargo.toml -p namecada --bin serve",
		"probe": "python3 scripts/probe-sources.py",
		"capture": "cargo run --manifest-path rust/Cargo.toml -p namecada --bin capture",
		"verify": "npm run check && npm test && npm run lint && npm run rust:fmt:check && npm run rust:clippy && npm run rust:test",
		"prepare": "husky"
	},
	"lint-staged": {
		"web/**/*.{js,cjs,mjs,ts,svelte}": [
			"prettier --write",
			"eslint --fix"
		],
		"web/**/*.{json,css,html,md}": "prettier --write",
		"rust/**/*.rs": "rustfmt --edition 2021",
		"src-tauri/**/*.rs": "rustfmt --edition 2021"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2.12.4",
		"concurrently": "^10.0.6",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0"
	},
	"license": "MIT OR Apache-2.0"
}
