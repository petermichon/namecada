{
	"name": "domain-browser",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=20.19"
	},
	"workspaces": [
		"web"
	],
	"scripts": {
		"dev": "npm run dev -w @domain-browser/web",
		"dev:android": "adb reverse tcp:5173 tcp:5173 && npm run dev",
		"build": "npm run build -w @domain-browser/web",
		"preview": "npm run preview -w @domain-browser/web",
		"test": "npm run test -w @domain-browser/web",
		"check": "npm run check -w @domain-browser/web",
		"lint": "npm run lint -w @domain-browser/web",
		"format": "npm run format -w @domain-browser/web",
		"server:dev": "go -C server run ./cmd/domainbrowser serve",
		"server:build": "go -C server build -o bin/domainbrowser ./cmd/domainbrowser",
		"server:test": "go -C server test ./...",
		"server:lint": "go -C server vet ./...",
		"server:fmt": "gofmt -w server",
		"server:tidy": "go -C server mod tidy",
		"verify": "npm run check && npm test && npm run lint"
	}
}
